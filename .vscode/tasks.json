{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ReSharper: Format current file",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "jb",
                "cleanupcode",
                "${file}",
                "--profile=Built-in: Reformat Code",
                "--verbosity=ERROR"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ]
}
